# Base URL for REST / WS (no trailing slash). Leave empty in dev to use same-origin + Vite proxy.
VITE_API_BASE_URL=

# Where Vite proxies /api, /health, /ws during `npm run dev` or `npm run preview` (FastAPI default).
# Health checks from the app use GET /api/v1/health (same /api prefix) so they work even if /health is not proxied.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
