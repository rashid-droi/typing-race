# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/typing_race?schema=public"

# App
APP_PUBLIC_URL="http://localhost:3000"
PORT=3000
NODE_ENV=development

# Admin seed / login defaults
