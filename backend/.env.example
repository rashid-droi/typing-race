# Copy to .env and adjust for your environment.
APP_NAME=typing-race-api
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed browser origins (no trailing slashes).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite database for admin analytics + managed events (created automatically).
DATABASE_PATH=data/typing-race.db

# Public player UI URL for join links and QR codes (no trailing slash).
APP_PUBLIC_URL=http://localhost:5173

# Optional: Redis for leaderboard pub/sub fan-out.
# REDIS_URL=redis://127.0.0.1:6379/0

# Leaderboard broadcast rate (Hz, clamped 5–10).
BROADCAST_HZ=8.0
MAX_PLAYERS_PER_SHARD=150
INSTANCE_ID=local-1
IDLE_SECONDS=45.0
SERVER_PING_INTERVAL_S=10.0

# Admin login (change before production).
ADMIN_COMPANY_SLUG=acme
ADMIN_EMAIL=admin@typingrace.local
ADMIN_PASSWORD=changeme
